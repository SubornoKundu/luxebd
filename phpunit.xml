<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_NAME" value="ShopEase"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- Shop settings the tests rely on. Pinned here so the values in a real .env (Vireluxe: bKash only,
             demo login off, free shipping at 6000...) never change the test results. -->
        <env name="SHOP_PAYMENT_METHODS" value="cod,bkash,nagad"/>
        <env name="SHOP_DEMO_LOGIN" value="true"/>
        <env name="SHOP_SETTINGS_ACCESS" value="true"/>
        <env name="SHOP_SHIPPING_FEE" value="60"/>
        <env name="SHOP_FREE_SHIPPING_OVER" value="5000"/>
        <env name="SHOP_LOW_STOCK_THRESHOLD" value="5"/>
        <env name="SHOP_BRAND_COLOUR" value="true"/>
        <env name="SHOP_ADVANCE_PERCENT" value="0"/>
        <env name="SHOP_ORDER_EMAILS" value="placed,paid,processing,shipped,completed,cancelled"/>
    </php>
</phpunit>
