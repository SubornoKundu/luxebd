# Local setup: cp .env.example .env, then php artisan key:generate. APP_DEBUG=true is fine on your own computer only.

APP_NAME=Vireluxe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vireluxe
DB_USERNAME=root
DB_PASSWORD=        

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Behind Cloudflare / a load balancer / a hosting proxy? Uncomment so real visitor IPs are used.
# TRUSTED_PROXIES=*

VITE_APP_NAME="${APP_NAME}"

# Shop numbers
SHOP_SHIPPING_FEE=60
SHOP_LOW_STOCK_THRESHOLD=5
SHOP_STOREFRONT_CACHE=120
SHOP_POPULAR_CACHE=600
SHOP_STATS_CACHE=120

# bKash only (manual): the customer sends money, then types the transaction ID. Admin marks it paid.
SHOP_PAYMENT_METHODS=bkash
SHOP_BKASH_NUMBER=01860291022
SHOP_BKASH_TYPE=Personal            # CHANGE to Agent / Merchant if that is what the number is

# Perfumes at/above this price show under Premium, the rest under Everyday.
SHOP_ADVANCE_PERCENT=50
SHOP_ORDER_EMAILS=processing
SHOP_PREMIUM_FROM=4000
# The "Visit us" map. Plus Code + area; open the map on the site once and check the pin is right.
SHOP_MAP_QUERY="22.935250,91.336250"
SHOP_MAP_LINK="https://maps.app.goo.gl/KcakqGNL1S6FSmVT9"

SHOP_ADDRESS="Uttor Char Mojlishpur (Plus Code W8PP+3GR)"
SHOP_PHONE="+880 1860-291022"          # ONE number for contact + hotline (top bar, footer, Contact page)
SHOP_EMAIL=xopsharip@gmail.com
SHOP_WHATSAPP=8801860291022            # same number; floating WhatsApp icon + footer button
SHOP_HOURS=

# CHANGE: paste the real page links (Facebook "Vireluxe", Instagram "Vireluxe bd", TikTok "Vireluxe perfume")
SHOP_FACEBOOK="https://www.facebook.com/profile.php?id=61579293577614"
SHOP_INSTAGRAM=https://www.instagram.com/vireluxe_bd
SHOP_TIKTOK=
SHOP_YOUTUBE=
SHOP_X=

SHOP_SETTINGS_ACCESS=false
SHOP_FREE_SHIPPING_OVER=6000

# First setup:  php artisan migrate --force && php artisan db:seed --class=VireluxeSeeder --force
#   then create the admin:  php artisan shop:admin you@example.com --replace   (asks for the password)
#   and sign in at  your-site.com/admin/login

# Free email through Gmail (password-reset codes, order emails). Make an "App password" in the Google account
# (Security > 2-Step Verification > App passwords), paste the 16 letters below and set MAIL_MAILER=smtp.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=xopsharip@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="xopsharip@gmail.com"

MAIL_FROM_NAME="${APP_NAME}"
